# Configuration de PRODUCTION — à copier en /var/www/coop/.env sur le VPS, puis compléter.
# Ne jamais committer le fichier .env réel (il contient des secrets).

APP_NAME="Coopérative Ngoundiane"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://coop.ngoundiane.sn
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# HTTPS obligatoire (§12, §13) : redirection http → https et en-tête HSTS
FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Base dédiée à la coopérative (ne pas réutiliser la base d'une autre application)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coop_ngoundiane
DB_USERNAME=coop_ngoundiane
DB_PASSWORD=A_REMPLIR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session limité au HTTPS
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ngoundiane.sn"
MAIL_FROM_NAME="${APP_NAME}"

# Sauvegardes quotidiennes (commande coop:sauvegarde)
MYSQLDUMP_PATH=/usr/bin/mysqldump

# Assistante « Fatou » : moteur local gratuit par défaut.
# Clé Claude facultative (payante) — voir README §6.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

VITE_APP_NAME="${APP_NAME}"
